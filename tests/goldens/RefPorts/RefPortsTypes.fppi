# ----------------------------------------------------------------------
# Remote wire format
# ----------------------------------------------------------------------

# The widths the remote deployment serialized its packet headers with.
# Declared whether or not a mirrored member uses one, because the decoders read
# every header field at these widths -- deliberately not at the local
# FwOpcodeType and friends, since a proxy has to agree with the sender.

@ The width of packet descriptors when they are serialized by the framework
@ [FwPacketDescriptorType]
type FwPacketDescriptorType = U16

@ The type of a command opcode
@ resolved from FwIdType to pin the remote's width
@ [FwOpcodeType]
type FwOpcodeType = U32

@ The type of an event identifier
@ resolved from FwIdType to pin the remote's width
@ [FwEventIdType]
type FwEventIdType = U32

@ The type of a telemetry channel identifier
@ resolved from FwIdType to pin the remote's width
@ [FwChanIdType]
type FwChanIdType = U32

@ The type of a telemetry packet identifier
@ [FwTlmPacketizeIdType]
type FwTlmPacketizeIdType = U16

# ----------------------------------------------------------------------
# Mirrored types
# ----------------------------------------------------------------------

# Type definitions mirrored from the remote dictionary.  Names are the
# remote's qualified names flattened with '_', because fpp-to-cpp derives a
# generated file name from a type's leaf name and rejects duplicates.
#
# Aliases resolve to the width the REMOTE serialized, which is the point of
# re-declaring them: the local platform's FwSizeType may differ.

@ [Ref.DpDemo.ColorEnum]
enum Ref_DpDemo_ColorEnum: I32 {
  RED = 0
  GREEN = 1
  BLUE = 2
}

@ [Ref.SignalPair]
struct Ref_SignalPair {
  $time: F32 format "{f}"
  value: F32 format "{f}"
}

@ [Ref.SignalPairSet]
array Ref_SignalPairSet = [4] Ref_SignalPair

@ [Ref.SignalSet]
array Ref_SignalSet = [4] F32 format "{f}"

@ [Ref.SignalType]
enum Ref_SignalType: I32 {
  TRIANGLE = 0
  SQUARE = 1
  SINE = 2
  NOISE = 3
}

@ [Ref.SignalInfo]
struct Ref_SignalInfo {
  $type: Ref_SignalType
  history: Ref_SignalSet
  pairHistory: Ref_SignalPairSet
}
