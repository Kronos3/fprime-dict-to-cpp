  uFPRIME_UNINITIALIZED = 0  @< The uninitialized state
  IDLE = 1  @< Interpreter does not have any modules loaded or a store initialized
  LOADING = 2  @< Interpreter is loading a Wasm module into the store
  RUNNING_AWAITING_RESPONSE = 3  @< a host function paused the interpreter to dispatch an F´ command; waiting for the command response to come back in
  RUNNING_PAUSED = 4
  RUNNING_SLEEPING = 5  @< sequencer is not taking any action, waiting for a time in the future to continue
  RUNNING_SPINNING = 6  @< sequencer is spinning the interpreter loop
  STARTING = 7  @< A module finished loading and the start function needs to be invoked/run
}

