# Do not edit: regenerate from the dictionary instead.

# ----------------------------------------------------------------------
# Remote wire format
# ----------------------------------------------------------------------

# The widths the remote deployment serialized its packet headers and string
# lengths with.  Declared whether or not a mirrored member uses one, because the
# decoders read every header field and string length at these widths --
# deliberately not at the local FwOpcodeType and friends, since a proxy has to
# agree with the sender.

@ The width of packet descriptors when they are serialized by the framework
@ [FwPacketDescriptorType]
type FwPacketDescriptorType = U16

@ The type of a command opcode
@ resolved from FwIdType to pin the remote's width
@ [FwOpcodeType]
type FwOpcodeType = U32

@ The type of an event identifier
@ resolved from FwIdType to pin the remote's width
@ [FwEventIdType]
type FwEventIdType = U32

@ The type of a telemetry channel identifier
@ resolved from FwIdType to pin the remote's width
@ [FwChanIdType]
type FwChanIdType = U32

@ The type of a telemetry packet identifier
@ [FwTlmPacketizeIdType]
type FwTlmPacketizeIdType = U16

@ The type used to serialize a size value
@ [FwSizeStoreType]
type Remote_FwSizeStoreType = U16

# ----------------------------------------------------------------------
# Mirrored types
# ----------------------------------------------------------------------

# Type definitions mirrored from the remote dictionary.  Names are the
# remote's qualified names flattened with '_', because fpp-to-cpp derives a
# generated file name from a type's leaf name and rejects duplicates.
#
# Aliases resolve to the width the REMOTE serialized, which is the point of
# re-declaring them: the local platform's FwSizeType may differ.

@ Enum representing a command response
@ [Fw.CmdResponse]
enum Fw_CmdResponse: U8 {
  OK = 0  @< Command successfully executed
  INVALID_OPCODE = 1  @< Invalid opcode dispatched
  VALIDATION_ERROR = 2  @< Command failed validation
  FORMAT_ERROR = 3  @< Command failed to deserialize
  EXECUTION_ERROR = 4  @< Command had execution error
  BUSY = 5  @< Component busy
}

@ Deserialization status
@ [Fw.DeserialStatus]
enum Fw_DeserialStatus: U8 {
  OK = 0
  BUFFER_EMPTY = 3  @< Deserialization buffer was empty when trying to read data
  FORMAT_ERROR = 4  @< Deserialization data had incorrect values (unexpected data types)
  SIZE_MISMATCH = 5  @< Data was left in in the buffer, but not enough to deserialize
  TYPE_MISMATCH = 6  @< Deserialized type ID didn't match
}

@ A bit mask for selecting the type of processing to perform on
@ a container before writing it to disk.
@ [Fw.DpCfg.ProcType]
enum Fw_DpCfg_ProcType: U8 {
  PROC_TYPE_NONE = 0  @< No Processing
  PROC_TYPE_ZLIB_DEFLATE = 1  @< Processing type 0
  PROC_TYPE_ONE = 2  @< Processing type 1
  PROC_TYPE_TWO = 4  @< Processing type 2
}

@ [Fw.DpState]
enum Fw_DpState: U8 {
  UNTRANSMITTED = 0  @< The untransmitted state
  PARTIAL = 1  @< The partially transmitted state A data product is in this state from the start of transmission until transmission is complete.
  TRANSMITTED = 2  @< The transmitted state
}

@ Enabled and disabled states
@ [Fw.Enabled]
enum Fw_Enabled: U8 {
  DISABLED = 0  @< Disabled state
  ENABLED = 1  @< Enabled state
}

@ Enum representing parameter validity
@ [Fw.ParamValid]
enum Fw_ParamValid: U8 {
  UNINIT = 0
  VALID = 1
  INVALID = 2
  DEFAULT = 3
}

@ FPP shadow-enum representing Fw::FormatStatus
@ [Fw.StringFormatStatus]
enum Fw_StringFormatStatus: U8 {
  SUCCESS = 0  @< Format worked
  OVERFLOWED = 1  @< Format overflowed
  INVALID_FORMAT_STRING = 2  @< Format provided invalid format string
  SIZE_OVERFLOW = 3  @< FwSizeType overflowed the range of size_t
  OTHER_ERROR = 4  @< An error was returned from an underlying call
}

@ Wait or don't wait for something
@ [Fw.Wait]
enum Fw_Wait: U8 {
  WAIT = 0  @< Wait for something
  NO_WAIT = 1  @< Don't wait for something
}

@ The type of a data product identifier
@ resolved from FwIdType to pin the remote's width
@ [FwDpIdType]
type FwDpIdType = U32

@ The type of smaller indices internal to the software, used
@ for array indices, e.g., port indices. Must be signed.
@ resolved from PlatformIndexType to pin the remote's width
@ [FwIndexType]
type FwIndexType = I16

@ The type of a parameter identifier
@ resolved from FwIdType to pin the remote's width
@ [FwPrmIdType]
type FwPrmIdType = U32

@ The unsigned type of larger sizes internal to the software,
@ e.g., memory buffer sizes, file sizes. Must be unsigned.
@ resolved from PlatformSizeType to pin the remote's width
@ [FwSizeType]
type FwSizeType = U64

@ FPP shadow-enum representing Os::RawTime::Status
@ [Os.RawTimeStatus]
enum Os_RawTimeStatus: U8 {
  OP_OK = 0  @< Operation was successful
  OP_OVERFLOW = 1  @< Operation result caused an overflow
  INVALID_PARAMS = 2  @< Parameters invalid for current platform
  NOT_SUPPORTED = 3  @< RawTime feature is not supported
  OTHER_ERROR = 4  @< All other errors
}

