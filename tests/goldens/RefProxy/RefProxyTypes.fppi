@ [Svc.WasmSequencer.TrapReason]
enum Svc_WasmSequencer_TrapReason: I32 {
  Unreachable = 0  @< Triggered by unreachable instruction
  Host = 1  @< A host function has noted an unrecoverable failure
  DivideByZero = 2  @< Integer or floating point division by zero
  InvalidTableIndex = 3  @< An indirect call tried to map to a table function out of range
  InvalidTableFunctionType = 4  @< The function type in an indirect call does not match the function pointer's type
  UninitializedTableElement = 5  @< An indirect call tried to map to a table function out of range
  GlobalGetFailed = 6  @< An imported global could not be read
  GlobalSetFailed = 7  @< An imported global could not be set
  OutOfMemory = 8  @< A memory operation is out of bounds
  MemoryRefNotUnique = 9  @< memory.grow failed because a host function has taken ownership of a memory
  MemoryOutOfBounds = 10  @< A memory operation is out of bounds
  StackOverflow = 11  @< Ran out of stack space
  UnrepresentableResult = 12  @< Attempting to convert Inf to integer
  IntegerOverflow = 13  @< Signed division causes integer overflow
  BadConversionToInteger = 14  @< Attempting to convert NaN to integer
}
